# Anthropic (OpenAI-compatible endpoint)
ANTHROPIC_API_KEY=

# Local vLLM / OpenAI-compatible servers
LOCAL_LLM_API_KEY=not-needed

# Catalog backend: fixtures | postgres
CS_BACKEND=postgres

# PostgreSQL catalogue and LangGraph checkpoint store
# Keep real credentials in .env only; never commit them.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/cs_electric

# Query embedding profile from cs_agent/config/embeddings.yaml.
# The active profile must match product_chunks.embedding's vector dimension.
CS_EMBEDDING_MODEL=minilm_l6_v2

# Optional model overrides, e.g.:
# CS_MODELS=all:qwen_27b
# CS_MODELS=agent:qwen_a3b,composer:qwen_27b
# CS_MODELS=

# Maximum SQL executions inside one analytics_query call (default: 4).
CS_ANALYTICS_MAX_QUERIES=4

# Structured execution trace (JSON Lines)
CS_LOG_FILE=logs/cs_agent_trace.jsonl
# Mirror every trace event to stdout. Defaults to true when omitted.
CS_LOG_TO_SCREEN=true
