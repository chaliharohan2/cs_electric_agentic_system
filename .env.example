# Anthropic (OpenAI-compatible endpoint)
ANTHROPIC_API_KEY=

# Local vLLM / OpenAI-compatible servers
LOCAL_LLM_API_KEY=not-needed

# Catalog backend: sqlite (default) | fixtures (offline tests)
CS_BACKEND=sqlite

# SQLite catalogue artifact (built by scripts/build_sqlite.py)
CS_SQLITE_PATH=artifacts/catalog-latest.sqlite
CS_CHECKPOINT_PATH=state/checkpoints.sqlite

# PostgreSQL is the build source only (refresh mv_* views, then build_sqlite.py).
# Keep real credentials in .env only; never commit them.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/cs_electric_v2

# Query embedding profile from cs_agent/config/embeddings.yaml.
# The active profile must match the catalogue embedding dimension (768).
CS_EMBEDDING_MODEL=gte_base_en_v1_5

# Optional model overrides, e.g.:
# CS_MODELS=all:qwen_27b
# CS_MODELS=agent:qwen_a3b,composer:qwen_27b
# Native Ollama profiles need no API key:
# CS_MODELS=all:ollama_27b
# CS_MODELS=all:ollama_35b
# CS_MODELS=

# Runtime caps (defaults are also in cs_agent/config/limits.yaml).
CS_GLOBAL_TOOL_BUDGET=100
CS_PER_AGENT_TOOL_BUDGET=20
# Ceiling for a brief the planner marked "overview" — a range-level answer.
CS_OVERVIEW_TOOL_BUDGET=6
# A gate retry resumes on the specialist's transcript, so it only needs budget
# for the fix the gate asked for.
CS_REVISION_TOOL_BUDGET=5
CS_COMPOSER_REVISIONS=2
CS_CLARIFY_ROUNDS=2
CS_TOOL_FAILURE_LIMIT=3
CS_MAX_PARALLEL_AGENTS=5
CS_ANALYTICS_MAX_QUERIES=4

# Vector tests run as part of `make test`. Set to 1 only to work without embeddings.
CS_SKIP_VECTOR_TESTS=0

# Structured execution trace (JSON Lines)
CS_LOG_FILE=logs/cs_agent_trace.jsonl
# Mirror every trace event to stdout. Defaults to true when omitted.
CS_LOG_TO_SCREEN=true

# Specialist streaming. The tool loop's prose and the report JSON print to the
# terminal as they generate, labelled with the agent that owns them. Set false to
# silence them; the final answer still streams.
CS_STREAM_AGENTS=true

# Where an enquiry this agent cannot answer is sent. Defaults live in
# cs_agent/config/contact.yaml; set these only to override that file.
# CS_CONTACT_WEBSITE=https://cselectric.co.in/
# CS_CONTACT_PHONE=1800-572-2012
