# Copy to .env and adjust for your environment.
APP_ENV=development
SECRET_KEY=dev-insecure-change-me

# SQLAlchemy database URL (PostgreSQL).
DATABASE_URL=postgresql+psycopg2://cselectric:cselectric@127.0.0.1:5432/cs_electric

# Database used by the test suite.
TEST_DATABASE_URL=postgresql+psycopg2://cselectric:cselectric@127.0.0.1:5432/cs_electric_test

# Flask dev server settings.
FLASK_APP=wsgi.py
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
